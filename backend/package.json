{
  "name": "nearby-locator-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "migrate": "node migrate.js",
    "test": "node test/run.js",
    "seed:admin": "node seed_super_admin.js",
    "docs:lint": "redocly lint docs/openapi.yaml",
    "docs:bundle": "redocly bundle docs/openapi.yaml -o dist/openapi.bundled.json --ext json",
    "docs:postman": "openapi2postmanv2 -s dist/openapi.bundled.json -o dist/postman_collection.json",
    "docs:test": "npm run docs:lint && npm run docs:bundle && npm run docs:postman"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.0",
    "handlebars": "^4.7.9",
    "jest": "^29.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.5.1",
    "nock": "^14.0.16",
    "node-jose": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.7",
    "supertest": "^6.3.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.38.0",
    "openapi-to-postmanv2": "^6.3.0",
    "pino-pretty": "^13.1.3"
  }
}
