# Environment variables for Nearby Locator
# PostgreSQL connection string (e.g., postgres://user:password@localhost:5432/nearbydb)
DATABASE_URL=postgres://username:password@localhost:5432/nearbydb

# Redis connection string (e.g., redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# JWT secret for signing tokens (use a strong random string)
JWT_SECRET=your_jwt_secret_here

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Places API key (already used)
GOOGLE_API_KEY=your_google_api_key
